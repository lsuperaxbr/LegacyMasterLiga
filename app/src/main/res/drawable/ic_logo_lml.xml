        android:pathData="M100,30 L100,55 M100,145 L100,170 M30,100 L55,100 M145,100 L170,100"
        android:strokeColor="#00FFCC"
        android:strokeWidth="2" />

    <path
        android:pathData="M70,70 L85,85 M130,70 L115,85 M70,130 L85,115 M130,130 L115,115"
        android:strokeColor="#00FFCC"
        android:strokeWidth="2" />

    <!-- Pentágono Central Neon -->
    <path
        android:pathData="M100,85 L115,95 L110,115 L90,115 L85,95 Z"
        android:strokeColor="#00FFCC"
        android:strokeWidth="1.5"
        android:fillColor="#3300FFCC" />

